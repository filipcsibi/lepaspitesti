# Where leads go — set the same variables in Vercel → Settings → Environment Variables.

# SalesPartner (lepas-ims): the same endpoint and keys as the other LEPAS sites.
CRM_WEBHOOK_URL_LEPAS=
CRM_API_KEY_LEPAS=
CRM_API_SECRET_LEPAS=

# E-mail copy of every lead (Resend)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM="LEPAS Pitești <leads@lepaspitesti.ro>"

# Optional
LEAD_WEBHOOK_URL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
